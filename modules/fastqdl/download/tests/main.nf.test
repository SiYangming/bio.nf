nextflow_process {

    name "Test Process FASTQDL_DOWNLOAD"
    script "../main.nf"
    process "FASTQDL_DOWNLOAD"

    tag "modules"
    tag "modules_nfcore"
    tag "fastqdl"
    tag "fastqdl/download"

    test("sra_ids_from_csv - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = Channel.fromPath('/Users/siyangming/nextflow_nf_core/bio.nf/modules/fastqdl/sra_ids_test.csv')
                            .splitCsv(header: false)
                            .map { row ->
                                def id = row[0]
                                [ [ id: id, single_end: true ], id ]
                            }
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out.fastq, process.out.versions, process.out.run_info, process.out.run_mergers).match() }
            )
        }
    }

    test("single_accession - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ], 'SRR13191702' ]
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out.fastq, process.out.versions, process.out.run_info, process.out.run_mergers).match() }
            )
        }
    }
}
