nextflow_process {

    name "Test Process ECC_FINDER_ASM_SR"
    script "../main.nf"
    process "ECC_FINDER_ASM_SR"

    tag "modules"
    tag "modules_nfcore"
    tag "ecc_finder"
    tag "ecc_finder/asm_sr"

    test("test-asm-sr - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], // meta
                             file("\${projectDir}/modules/ecc_finder/testdata/Arabi.1kReads.R1.fastq.gz", checkIfExists: true) ]
                input[1] = [ [ id:'test' ], // meta2
                             file("\${projectDir}/modules/ecc_finder/testdata/Arabi.1kReads.R2.fastq.gz", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
