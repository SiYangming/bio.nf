nextflow_process {

    name "Test Process ECC_FINDER_ASM_ONT"
    script "../main.nf"
    process "ECC_FINDER_ASM_ONT"

    tag "modules"
    tag "modules_nfcore"
    tag "ecc_finder"
    tag "ecc_finder/asm_ont"

    test("test-asm-ont - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], // meta
                             file("\${projectDir}/modules/ecc_finder/testdata/Arabi.ONT.1kReads.fasta.gz", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
